    {
      "name": "03 Management lifecycle (authenticated)",
      "item": [
        {
          "name": "Create draft",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get('runId')) { pm.collectionVariables.set('runId', Date.now().toString(36)); }"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const created = pm.response.json();",
                  "pm.collectionVariables.set('announcementId', created.id);",
                  "pm.test('Location header', () => pm.expect(pm.response.headers.get('Location')).to.match(new RegExp('/api/announcements/' + created.id + '$')));",
                  "pm.test('draft has no publication date', () => pm.expect(created.publishedAt).to.eql(null));",
                  "pm.test('author from token', () => pm.expect(pm.response.json().createdBy).to.not.eql('anonymous'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/announcements",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman {{runId}}\",\n  \"summary\": \"Created by the API regression suite\",\n  \"body\": \"Secret body\",\n  \"category\": \"GENERAL\",\n  \"status\": \"DRAFT\"\n}"
            }
          }
        },
        {
          "name": "Draft is not in public search",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('no draft', () => pm.expect(pm.response.json().totalItems).to.eql(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/announcements/search?q=Postman%20{{runId}}"
          }
        },
        {
          "name": "Management list includes draft",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('draft listed', () => pm.expect(pm.response.json().items.map((i) => i.id)).to.include(Number(pm.collectionVariables.get('announcementId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/announcements?status=DRAFT&size=100"
          }
