{
    "microservices": [
        {
            "name": "announcement-ms",
            "stack": "spring-boot",
            "healthCheckPath": "/api/health",
            "dbms": "postgresql"
        }
    ],
    "microfrontends": [
        {
            "name": "announcement-board",
            "customElement": "announcement-board",
            "stack": "react",
            "type": "widget",
            "group": "free",
            "publicFolder": "public",
            "titles": {
                "en": "Announcement Board",
                "it": "Bacheca Annunci"
            },
            "buildFolder": "dist",
            "category": "Announcements",
            "apiClaims": [
                {
                    "name": "announcement-api",
                    "type": "internal",
                    "serviceName": "announcement-ms"
                }
            ],
            "contextParams": [
                "page_code",
                "info_currentLang"
            ],
            "configMfe": "announcement-board-config",
            "params": [
                {
                    "name": "boardTitle",
                    "description": "Heading shown above the board (1-80 characters). Default: Announcements"
                },
                {
                    "name": "pageSize",
                    "description": "Results per page, 1-50. Default: 10"
                },
                {
                    "name": "defaultCategory",
                    "description": "Pre-selected category: ALL, GENERAL, TRAINING, EVENT or MAINTENANCE. Default: ALL"
                },
                {
                    "name": "showSearchBox",
                    "description": "Show the free-text search box: true or false. Default: true"
                }
            ]
        },
        {
            "name": "announcement-manager",
            "customElement": "announcement-manager",
            "stack": "react",
            "type": "widget",
            "group": "free",
            "publicFolder": "public",
            "titles": {
                "en": "Announcement Manager",
                "it": "Gestione Annunci"
            },
            "buildFolder": "dist",
            "category": "Announcements",
            "apiClaims": [
                {
                    "name": "announcement-api",
                    "type": "internal",
                    "serviceName": "announcement-ms"
                }
            ]
        },
        {
            "name": "announcement-board-config",
            "customElement": "announcement-board-config",
            "stack": "react",
            "type": "widget-config",
            "group": "free",
            "publicFolder": "public",
            "buildFolder": "dist"
        }
    ],
    "svc": [
        "postgresql"
    ],
    "name": "training26",
    "version": "0.7.1",
    "description": "Announcement Board: Entando 7.5 developer training bundle (E101, Day 2)",
    "type": "bundle",
    "displayName": "Announcement Board"
}
