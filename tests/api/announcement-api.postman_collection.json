{
  "info": {
    "_postman_id": "7e30e103-c641-530d-b3c0-8f3b9368307c",
    "name": "announcement-ms API regression",
    "description": "Phase B (step 20+): only GET /api/announcements/search (and /api/health) are anonymous; needs accessToken and expiredToken in the environment (see doc/runbooks/keycloak.md).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Infrastructure",
      "item": [
        {
          "name": "Health is anonymous",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('UP', () => pm.expect(pm.response.json().status).to.eql('UP'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/health"
          }
        },
        {
          "name": "OpenAPI document",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 401', () => pm.response.to.have.status(401));",
                  "pm.test('WWW-Authenticate: Bearer', () => pm.expect(pm.response.headers.get('WWW-Authenticate') || '').to.match(/^Bearer/));",
                  "pm.test('no business data in the error body', () => {",
                  "  const text = pm.response.text();",
                  "  pm.expect(text).to.not.include('Secret body');",
                  "  pm.expect(text).to.not.include('\"items\"');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/v3/api-docs"
          }
        }
      ]
    },
    {
      "name": "02 Public search",
      "item": [
        {
          "name": "Search without token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 200', () => pm.response.to.have.status(200));",
                  "pm.test('summaries only: no body, status or author', () => {",
                  "  pm.response.json().items.forEach((item) => {",
                  "    pm.expect(item).to.have.all.keys('id', 'title', 'summary', 'category', 'publishedAt');",
                  "  });",
                  "});"
